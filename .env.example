# Copy to .env and edit. Nothing here is a secret; the file stays out of git anyway.

# Face detector for step 1 (optional). Download face_detection_yunet_2023mar.onnx from the OpenCV Zoo.
YUNET_MODEL=models/face_detection_yunet_2023mar.onnx

# Tools on PATH are found automatically; set these only to override.
# FFMPEG=/usr/bin/ffmpeg
# FFPROBE=/usr/bin/ffprobe

# GPU steps (WhisperX alignment, Florence-2): "cuda" or "cpu".
DEVICE=cuda
WHISPER_LANG=pt
FLORENCE_MODEL=microsoft/Florence-2-large

# Sound / media library used by montagem/preparar_video.py (needs a CATALOGO.csv with id, caminho_relativo).
LIBRARY_DIR=exemplos/biblioteca_exemplo
CATALOG_CSV=exemplos/biblioteca_exemplo/CATALOGO.csv

# Guides folder (scanned recursively) and feedback folder.
GUIDES_DIR=docs
FEEDBACK_DIR=docs/feedback

# Where downloaded study references go.
REF_DIR=refs
